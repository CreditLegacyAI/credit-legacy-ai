# ============================================================
# Credit Legacy AI · Environment Variables
# ============================================================
# Copia este archivo a .env.local y completa con tus valores reales.
# NUNCA commitees .env.local al repo (ya está en .gitignore).
# ============================================================


# ---- Supabase ----
# Obtén estas en: https://supabase.com → Tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://efdwsgqqadkjcyutksox.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here


# ---- Anthropic Claude ----
# Obtén en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here


# ---- Cifrado (para SSN/ITIN) ----
# Genera con: openssl rand -base64 32
# DEBE tener al menos 32 caracteres
ENCRYPTION_SECRET=your_32_character_minimum_secret_here


# ---- Site URL ----
# Local: http://localhost:3000
# Prod:  https://creditlegacy.ai (o tu dominio Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- (Phase 2+ · Opcional) ----
# Stripe (para billing real)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Array API (para credit reports)
# ARRAY_API_KEY=...
# ARRAY_API_URL=https://api.array.io

# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=...

# PostHog (analytics)
# NEXT_PUBLIC_POSTHOG_KEY=...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
